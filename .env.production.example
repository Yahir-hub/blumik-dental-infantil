# TEMPLATE ONLY. Runtime secrets must be supplied by the future provider.
HYRONIX_ENVIRONMENT=production
HYRONIX_ENABLED=true
HYRONIX_CONTENT_API_URL=
HYRONIX_SITE_KEY=
HYRONIX_CONTENT_REVALIDATE_SECONDS=60
HYRONIX_WEBHOOK_SECRET=
HYRONIX_STORE_DRIVER=postgres
HYRONIX_STORE_URL=
HYRONIX_STORE_PUBLISHABLE_KEY=
HYRONIX_STORE_TOKEN=
HYRONIX_STORE_NAMESPACE=blumik-production
HYRONIX_PREWARM=true
# Independent production KV and D1 bindings required; do not reuse staging IDs.
# No administrative Supabase secret belongs in Blumik.
